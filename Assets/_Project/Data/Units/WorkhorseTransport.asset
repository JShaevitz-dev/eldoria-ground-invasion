  m_Script: {fileID: 11500000, guid: 3be3048eed6de9b48a1a9ab3da6b5b67, type: 3}
  m_Name: WorkhorseTransport
  m_EditorClassIdentifier: Eldoria::Eldoria.Units.UnitTemplate
  displayName: Workhorse Transport
  role: 4
  description: 'The ISF''s armored troop carrier: a six-wheeled truck with an armored
    cargo body that can carry one unit of Biological soldiers, however many, across
    the battlefield. Embark takes a friendly unit within 2.5 m aboard, safe from
    fire; Disembark puts it out at once to make its move. It drives 40 m (it can''t
    sprint, being Mechanical), and with 10 health and Armor Level 3 it shrugs off
    rifles and pistols. A roof-mounted Machine Gun (5 shots, 5 damage, penetration
    1, 20 m) can fire on the move thanks to its Stabilizers. A unit aboard is lost
    if it''s destroyed. A Transport: you can field more than one.'
  leader: {fileID: 11400000, guid: b19b1ea0b1e4dfe4e876aeca444de0c9, type: 2}
  members: []
  equipmentSwapsForWholeUnit: 0
  supplyCost: 88
  deploymentSpacing: 2
